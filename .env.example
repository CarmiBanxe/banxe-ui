# BANXE AI BANK — Environment Variables
# Copy to .env and fill in values

# API
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_AI_INSIGHTS=true
VITE_ENABLE_CRYPTO_WALLETS=true
VITE_ENABLE_BIOMETRIC_AUTH=false

# Analytics (optional)
VITE_ANALYTICS_KEY=
VITE_SENTRY_DSN=

# Storybook
STORYBOOK_PORT=6006
