{
  "name": "banxe-ui",
  "version": "0.1.0",
  "private": true,
  "description": "BANXE AI BANK — UI prototype workspace (Developer Plane)",
  "workspaces": [
    "packages/*",
    "apps/web",
    "storybook"
  ],
  "scripts": {
    "build:tokens": "npm run build --workspace=packages/design-tokens",
    "build:storybook": "npm run build-storybook --workspace=storybook",
    "storybook": "npm run storybook --workspace=storybook",
    "test": "npm run test --workspace=packages/ui",
    "test:all": "npm run test --workspace=packages/ui && vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "eslint packages/ui/src apps/web/src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --build packages/ui/tsconfig.json apps/web/tsconfig.json",
    "semgrep": "semgrep --config .semgrep/banxe-ui-rules.yaml apps/web/src packages/ui/src",
    "quality": "bash scripts/banxe-build.sh",
    "test:a11y": "npx vitest run tests/a11y"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "axe-core": "^4.11.2",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@tremor/react": "^3.18.7"
  }
}
