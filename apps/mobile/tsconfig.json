{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "types": [
      "nativewind/types"
    ]
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "components/**/*",
    "global.css",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "App.tsx"
  ]
}
