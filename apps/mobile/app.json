{
  "expo": {
    "name": "BANXE AI BANK",
    "slug": "banxe-mobile",
    "scheme": "banxe",
    "version": "0.1.0",
    "sdkVersion": "53.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7FA"
    },
    "ios": {
      "bundleIdentifier": "com.banxe.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "BANXE uses Face ID for secure authentication (PSD2 SCA)"
      }
    },
    "android": {
      "package": "com.banxe.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FA"
      }
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        { "photosPermission": "BANXE needs access to your photos for KYC document upload" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
