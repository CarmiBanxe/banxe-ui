{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "Edit",
      "MultiEdit",
      "Write",
      "Bash"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/developer/.claude/hooks/banxe-ui-session-start.sh"
          },
          {
            "type": "command",
            "command": "claude mcp list 2>/dev/null | head -5 || echo 'No MCPs — run /setup-mcp'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/developer/.claude/hooks/inject-design-rules.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/developer/.claude/hooks/pro-workflow-capture.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/developer/.claude/hooks/pro-workflow-capture.py --session-end"
          }
        ]
      }
    ]
  },
  "commands": [
    "/banxe-generate-migration",
    "/banxe-generate-tests",
    "/banxe-k8s-diff",
    "/banxe-review-pr",
    "/banxe-review-tf",
    "/banxe-ui-review-pr",
    "/banxe-update-api-docs"
  ],
  "canon": "Не задавай уточняющих вопросов на безопасные команды. На неоднозначности отвечай сам по принципу лучшего ответа. Экономь время и ресурсы. Действуй немедленно.",
  "automations": {
    "pr_review": true,
    "test_runner": true,
    "security_scan": true
  },
  "deny_paths": [
    "compliance/cases/*",
    "kyc/raw/*",
    "secrets/*"
  ]
}
